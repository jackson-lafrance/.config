# Rosé Pine notification styling for dunst.
# Palette matches ~/.config/hypr/hyprland.conf and ~/.config/quickshell/Theme.qml.

[global]
    monitor = 0
    follow = keyboard

    width = 380
    height = 120
    origin = top-right
    offset = 18x48
    notification_limit = 4

    font = Agave Nerd Font Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#ebbcba"
    separator_color = frame
    corner_radius = 12

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 160
    progress_bar_max_width = 340
    highlight = "#c4a7e7"

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1f1d2e"
    foreground = "#e0def4"
    frame_color = "#31748f"
    timeout = 4

[urgency_normal]
    background = "#1f1d2e"
    foreground = "#e0def4"
    frame_color = "#c4a7e7"
    timeout = 6

[urgency_critical]
    background = "#26233a"
    foreground = "#e0def4"
    frame_color = "#eb6f92"
    timeout = 0

[slaade]
    appname = "SLAADE"
    background = "#191724"
    foreground = "#e0def4"
    frame_color = "#ebbcba"
    timeout = 4
